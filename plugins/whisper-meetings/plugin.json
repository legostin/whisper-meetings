{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "whisper-meetings",
  "version": "0.6.0",
  "description": "Record meetings on your Mac, transcribe with local Whisper, and analyze or hand off the results.",
  "author": {
    "name": "legostin",
    "url": "https://github.com/legostin"
  },
  "license": "MIT",
  "keywords": [
    "meetings",
    "whisper",
    "local",
    "audio",
    "calendar",
    "google-meet",
    "mcp-apps"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Whisper Meetings",
        "shortDescription": "Local meeting recording and transcription",
        "longDescription": "Record and pause meeting audio on your Mac. Read provisional local Whisper text during recording, then get final transcripts, speaker estimates and concise reports after stopping.",
        "developerName": "legostin",
        "category": "Productivity",
        "capabilities": [
          "Record audio",
          "Transcribe locally",
          "Read transcripts",
          "Save meeting analysis",
          "Prepare context packages",
          "Link calendar events",
          "Estimate speakers",
          "Mark overlapping speech",
          "Pause and resume recording",
          "Transcribe during recording",
          "Connect configured Google Calendar"
        ],
        "defaultPrompt": [
          "Open the meeting panel",
          "Record this meeting with local Whisper transcription",
          "Analyze my last meeting and link it to a calendar event"
        ],
        "websiteURL": "https://github.com/legostin/whisper-meetings",
        "supportURL": "https://github.com/legostin/whisper-meetings/issues",
        "privacyPolicyURL": "https://github.com/legostin/whisper-meetings/blob/main/plugins/whisper-meetings/PRIVACY.md",
        "termsOfServiceURL": "https://github.com/legostin/whisper-meetings/blob/main/plugins/whisper-meetings/TERMS.md",
        "brandColor": "#202020",
        "brandColorDark": "#EEEEEE",
        "composerIcon": "./assets/icon.png",
        "composerIconDark": "./assets/icon-dark.png",
        "logo": "./assets/logo.png",
        "logoDark": "./assets/logo-dark.png"
      },
      "onboardingSkill": "./skills/meetings/SKILL.md",
      "publication": {
        "release_notes": "0.6.0 prerelease: direct Google Calendar preview for locally configured installations with Desktop OAuth, PKCE and macOS Keychain tokens. Pick, refresh or disconnect through the panel, or paste a Meet link without an account. Public shared Google login is not yet configured. Calendar reads only; existing recording/live features retained."
      }
    }
  },
  "homepage": "https://github.com/legostin/whisper-meetings",
  "repository": "https://github.com/legostin/whisper-meetings"
}
